    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <AssemblyName>LaserGRBL.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3"><PrivateAssets>all</PrivateAssets></PackageReference>
    <Reference Include="LaserGRBL"><HintPath>../../LaserGRBL/bin/Release/LaserGRBL.exe</HintPath><Private>true</Private></Reference>
    <Compile Include="../../LaserGRBL.Tests/*.cs" />
  </ItemGroup>
</Project>
